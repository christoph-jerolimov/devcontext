{
  "name": "devcontext-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Sync development data locally to give people and AI complete project context.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "workspaces": [
    "cli",
    "web",
    "site"
  ],
  "scripts": {
    "build": "npm run build --workspace @devcontext/web && npm run build --workspace @devcontext/cli",
    "build:cli": "npm run build --workspace @devcontext/cli",
    "build:web": "npm run build --workspace @devcontext/web",
    "dev:web": "npm run dev --workspace @devcontext/web",
    "docs": "npm run docs --workspace @devcontext/cli",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspace @devcontext/cli",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "devcontext": "npm run --silent start --workspace @devcontext/cli --",
    "build:site": "npm run build --workspace @devcontext/site",
    "dev:site": "npm run dev --workspace @devcontext/site"
  },
  "devDependencies": {
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "typescript": "^7.0.2"
  }
}
