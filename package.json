{
  "name": "devcontext-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Sync development data locally to give people and AI complete project context.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "workspaces": [
    "cli",
    "web"
  ],
  "scripts": {
    "build": "npm run build --workspace @devcontext/web && npm run build --workspace @devcontext/cli",
    "build:cli": "npm run build --workspace @devcontext/cli",
    "build:web": "npm run build --workspace @devcontext/web",
    "dev:web": "npm run dev --workspace @devcontext/web",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "devcontext": "npm run --silent start --workspace @devcontext/cli --"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0"
  }
}
