{
  "name": "@devcontext/tui",
  "version": "0.1.0",
  "private": true,
  "description": "Terminal viewer for the local devcontext database: the same views as the web viewer, without a browser.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "bin": {
    "devcontext-tui": "./bin/devcontext-tui.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node bin/devcontext-tui.js"
  },
  "dependencies": {
    "@devcontext/cli": "*",
    "ink": "7.1.1",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "24.x",
    "@types/react": "19.2.2",
    "ink-testing-library": "4.0.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
